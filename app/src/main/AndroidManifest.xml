<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />

    <!-- Bluetooth (Android 11 o menos) -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <!-- Bluetooth (Android 12 o más) -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Ubicación: mapa y GPS del teléfono -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Internet: descargar el mapa -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Vibrar con el aviso de velocidad -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Mandar el micrófono al casco / audífonos Bluetooth -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Seguir viva en segundo plano (notificación "App activa") -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Antirrobo del teléfono (Vigilancia.kt): fotos y audio con la pantalla apagada -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Modo moto: abrir el tablero sola al montar el teléfono ("Mostrar sobre otras apps") -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Etiqueta NFC en el soporte (modo moto) -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />
    <!-- Dashcam (cámara de atrás, sin audio) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- RPM por vibración: leer el acelerómetro a más de 200 veces por segundo -->
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />
    <!-- Pedir que Android no la duerma por ahorro de batería -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Ahorro nocturno: entrar y salir a la hora exacta, recalcular al arrancar el teléfono y pausar la
         sincronización automática de cuentas (se regresa como estaba) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.READ_SYNC_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SYNC_SETTINGS" />
    <!-- Actualizarse sola (Ajustes → Acerca de): instalar la versión nueva encima. Android siempre pide confirmar -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- SOS por caída (opcional, apagado de fábrica): mandar tu ubicación por SMS a tu contacto de emergencia.
         Sin este permiso se abre tu app de mensajes ya escrita -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <!-- Para ver las apps de música, la voz y el dictado -->
    <queries>
        <intent>
            <action android:name="android.media.browse.MediaBrowserService" />
        </intent>
        <!-- Voz del teléfono (clima y avisos) -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- Dictado por voz para buscar música -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- Página de apps (launcher): ver las apps que se pueden abrir -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- CarPlay: DiPlay (receptor de CarPlay) y su servicio del mapa en vivo -->
        <package android:name="com.shihab.diplay" />
        <package android:name="com.shihab.diplay.hudtest" />
        <intent>
            <action android:name="com.shihab.diplay.action.EMBED_MAP" />
        </intent>
        <!-- Selector de salida de audio del sistema -->
        <package android:name="com.android.systemui" />
        <intent>
            <action android:name="com.android.settings.panel.action.MEDIA_OUTPUT" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.FT150TS">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- La etiqueta NFC del soporte (grabada por la app) la abre directo -->
            <intent-filter>
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="ft150ts" android:host="moto" />
            </intent-filter>
            <!-- Atajos del ícono (Tablero, Mapa, Moto) -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/atajos" />
        </activity>

        <!-- Modo launcher: apagado de fábrica, se prende en Ajustes > Launcher -->
        <activity-alias
            android:name=".Inicio"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <!-- Lee notificaciones (para mandarlas a la moto) y controla la música -->
        <service
            android:name=".NotifListener"
            android:exported="false"
            android:label="@string/servicio_notif"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Mantiene la conexión con la moto en segundo plano -->
        <service
            android:name=".ServicioMoto"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|location|camera|microphone" />

        <!-- Ahorro nocturno: su alarma y los eventos del sistema que obligan a recalcular el horario.
             No exportado: solo Android (o esta app) le puede mandar algo -->
        <!-- Sonoridad +: los reproductores avisan "abrí / cerré mi sesión de audio" (el mismo aviso que usan los
             ecualizadores). Solo se lee el número de sesión. -->
        <receiver
            android:name=".ReceptorSesionAudio"
            android:exported="true">
            <intent-filter>
                <action android:name="android.media.action.OPEN_AUDIO_EFFECT_CONTROL_SESSION" />
                <action android:name="android.media.action.CLOSE_AUDIO_EFFECT_CONTROL_SESSION" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".NocturnoReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Para compartir la ruta exportada (GPX) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.archivos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/archivos" />
        </provider>
    </application>
</manifest>
